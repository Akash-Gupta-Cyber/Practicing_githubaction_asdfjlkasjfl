name: Build automatic Deploy mannual
on:
  push:
  workflow_dispatch:
jobs:
  building:
    if: github.event_name == 'push'
    runs-on: ubuntu-22.04
    steps:
      - name: building automatically
        run: echo 'building automatically...'
  deploying:
  # needs: building this will skip the second job so remove needs: building 
    if: github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-22.04
    steps:
      - name: deplying mannually
        run: echo 'deplying mannually...'
